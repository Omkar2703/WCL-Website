# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string (MongoDB Atlas or a local mongod instance)
MONGO_URI=mongodb://127.0.0.1:27017/wcl

# Long random string used to sign admin JWTs
JWT_SECRET=change-this-to-a-long-random-string

# Port the Express API listens on
PORT=5000

# Comma-separated list of origins allowed to call the API (your client URL)
CLIENT_ORIGIN=http://localhost:5173

# First admin account, created automatically by `npm run seed` if no admin exists yet
ADMIN_EMAIL=admin@wcl.iitgn.ac.in
ADMIN_PASSWORD=change-this-password

# SMTP credentials used to notify the admin when the contact form is submitted.
# Leave blank to skip email notifications (messages are still saved to MongoDB).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=admin@wcl.iitgn.ac.in
